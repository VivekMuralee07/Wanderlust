<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: cloud backup and device-to-device transfer. The settings file (encrypted API key) is never copied. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="attachments/" />
        <exclude domain="sharedpref" path="wanderlust_settings.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="." />
        <exclude domain="sharedpref" path="wanderlust_settings.xml" />
    </device-transfer>
</data-extraction-rules>
