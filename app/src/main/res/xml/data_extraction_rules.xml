<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: only the listed paths are copied. Shared preferences (incl. the encrypted API key) are not listed, so never backed up. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="attachments/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
